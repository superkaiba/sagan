# Copy to .env (gitignored) and fill in real values for local dev.
# Production values go in Vercel project settings (apps/web) and the
# runner systemd unit on the VM (services/runner).

# ─── Database (Neon) ──────────────────────────────────────────────────────
# Pooled connection string from the Neon dashboard. The pooler is required
# for serverless functions; direct connection is fine for the runner.
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) URL — used by drizzle-kit for migrations and by the
# runner for LISTEN/NOTIFY (which doesn't work through the pooler).
DATABASE_URL_DIRECT="postgresql://user:pass@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Set to 1 for verbose Drizzle query logging during development.
DB_DEBUG=0

# ─── Auth ─────────────────────────────────────────────────────────────────
# Owner credentials seeded into the users table on first boot.
DASHBOARD_OWNER_EMAIL="thomasjiralerspong@gmail.com"
DASHBOARD_OWNER_PASSWORD="change-me-on-first-login"

# ─── Public site ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── AI providers (used by runner + lit-review embeddings) ────────────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ─── RunPod (Phase 2) ─────────────────────────────────────────────────────
# Two scopes: agent_runs.runpod_account ∈ {team, personal} picks one.
# Defaults to the Anthropic Safety Research team if RUNPOD_TEAM_ID_TEAM is unset.
RUNPOD_API_KEY=""              # legacy fallback for team scope
RUNPOD_API_KEY_TEAM=""         # preferred for account=team
RUNPOD_TEAM_ID_TEAM=""         # leave empty to use the Anthropic team default
RUNPOD_API_KEY_PERSONAL=""     # required only for account=personal

# ─── Optional integrations ────────────────────────────────────────────────
WANDB_API_KEY=""
HF_TOKEN=""
TWITTER_BEARER_TOKEN=""
SEMANTIC_SCHOLAR_API_KEY=""
