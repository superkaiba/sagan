{
  "expo": {
    "name": "Sagan",
    "slug": "eps-research-dashboard",
    "scheme": "sagan",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e24"
    },
    "ios": {
      "bundleIdentifier": "com.superkaiba.sagan",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sagan uses your microphone for voice dispatch.",
        "NSSpeechRecognitionUsageDescription": "Sagan transcribes spoken commands into agent prompts."
      }
    },
    "android": {
      "package": "com.superkaiba.sagan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0e24"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sagan uses your microphone for voice dispatch.",
          "speechRecognitionPermission": "Sagan transcribes spoken commands into agent prompts.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d66182e9-9173-48e9-8048-6d46e29e8cd4"
      }
    },
    "owner": "superkaiba",
    "updates": {
      "url": "https://u.expo.dev/d66182e9-9173-48e9-8048-6d46e29e8cd4"
    }
  }
}
